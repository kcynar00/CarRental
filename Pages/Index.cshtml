@page
@model CarRental.Pages.IndexModel
@{
    ViewData["Title"] = "Strona główna";
    var isAuth = User?.Identity?.IsAuthenticated == true;
    var userName = User?.Identity?.Name;
}

<div class="container py-5">

    <!-- Gablotki: zawsze 1×4 -->
    <section class="cr-section pt-0">
        <div class="cr-tiles cr-tiles--4">

            <article class="cr-card cr-card--pad cr-lift">
                <div class="cr-stat">
                    <div class="cr-stat__icon cr-icon--primary" aria-hidden="true">
                        <i class="fa-solid fa-car-side"></i>
                    </div>
                    <div class="cr-stat__text">
                        <div class="cr-stat__value">8</div>
                        <div class="cr-stat__label">Aut w bazie</div>
                    </div>
                </div>
            </article>

            <article class="cr-card cr-card--pad cr-lift">
                <div class="cr-stat">
                    <div class="cr-stat__icon cr-icon--success" aria-hidden="true">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                    <div class="cr-stat__text">
                        <div class="cr-stat__value">2 min</div>
                        <div class="cr-stat__label">Śr. czas rezerwacji</div>
                    </div>
                </div>
            </article>

            <article class="cr-card cr-card--pad cr-lift">
                <div class="cr-stat">
                    <div class="cr-stat__icon cr-icon--warning" aria-hidden="true">
                        <i class="fa-solid fa-star"></i>
                    </div>
                    <div class="cr-stat__text">
                        <div class="cr-stat__value">4.9/5</div>
                        <div class="cr-stat__label">Ocena klientów</div>
                    </div>
                </div>
            </article>

            <article class="cr-card cr-card--pad cr-lift">
                <div class="cr-stat">
                    <div class="cr-stat__icon cr-icon--info" aria-hidden="true">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div class="cr-stat__text">
                        <div class="cr-stat__value">24/7</div>
                        <div class="cr-stat__label">Wsparcie &amp; pomoc</div>
                    </div>
                </div>
            </article>

        </div>
    </section>

    <!-- Karty akcji: zawsze 1×3 -->
    <section class="cr-section">
        <div class="cr-tiles cr-tiles--3">

            <a class="cr-card cr-card--pad cr-action cr-lift" href="/Cars">
                <div class="cr-action__icon cr-icon--primary" aria-hidden="true">
                    <i class="fa-solid fa-car"></i>
                </div>
                <div class="cr-action__body">
                    <h2 class="cr-action__title">Oferta samochodów</h2>
                    <p class="cr-action__desc">Filtruj po klasie, cenie i dostępności.</p>
                </div>
                <div class="cr-action__chev" aria-hidden="true">
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>

            <a class="cr-card cr-card--pad cr-action cr-lift" href="/Reservations/My">
                <div class="cr-action__icon cr-icon--success" aria-hidden="true">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div class="cr-action__body">
                    <h2 class="cr-action__title">Moje rezerwacje</h2>
                    <p class="cr-action__desc">Statusy, historia i szczegóły w jednym miejscu.</p>
                </div>
                <div class="cr-action__chev" aria-hidden="true">
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>

            <a class="cr-card cr-card--pad cr-action cr-lift" asp-area="Identity" asp-page="/Account/Manage/Index">
                <div class="cr-action__icon cr-icon--warning" aria-hidden="true">
                    <i class="fa-solid fa-user-gear"></i>
                </div>
                <div class="cr-action__body">
                    <h2 class="cr-action__title">Moje konto</h2>
                    <p class="cr-action__desc">Dane profilu, bezpieczeństwo i ustawienia.</p>
                </div>
                <div class="cr-action__chev" aria-hidden="true">
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            </a>

        </div>
    </section>

    <!-- Jak to działa: zawsze 1×3 -->
    <section class="cr-section">
        <h2 class="cr-section-title">Jak to działa</h2>
        <p class="cr-section-subtitle">Trzy proste kroki i jesteś w drodze.</p>

        <div class="cr-tiles cr-tiles--3">

            <div class="cr-card cr-card--pad cr-lift">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="cr-stat__icon cr-icon--primary" aria-hidden="true">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-0">1) Wybierz auto</h3>
                </div>
                <p class="text-muted mb-0">Przeglądaj ofertę i sprawdź dostępność.</p>
            </div>

            <div class="cr-card cr-card--pad cr-lift">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="cr-stat__icon cr-icon--success" aria-hidden="true">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-0">2) Zarezerwuj termin</h3>
                </div>
                <p class="text-muted mb-0">Ustal daty i potwierdź rezerwację.</p>
            </div>

            <div class="cr-card cr-card--pad cr-lift">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="cr-stat__icon cr-icon--info" aria-hidden="true">
                        <i class="fa-solid fa-rocket"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-0">3) Odbierz i jedź</h3>
                </div>
                <p class="text-muted mb-0">Szybki odbiór, jasne zasady, zero tarcia.</p>
            </div>

        </div>
    </section>

</div>
