@page
@model CarRental.Pages.Reservations.MyModel
@{
    ViewData["Title"] = "Moje rezerwacje";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container-fluid p-4 p-md-5 bg-light min-vh-100">
    
    <div class="row mb-5 align-items-end">
        <div class="col-md-8">
            <h6 class="text-uppercase text-muted ls-1 mb-2" style="font-size: 0.75rem; letter-spacing: 2px;">Panel Klienta</h6>
            <h1 class="display-5 fw-bold text-dark mb-0">Twoje Rezerwacje</h1>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
             <div class="d-inline-flex align-items-center bg-white px-4 py-2 rounded-pill shadow-sm">
                 <span class="text-muted small me-2">Łącznie wynajmów:</span>
                 <span class="fw-bold text-primary fs-5">@(Model.Reservations?.Count ?? 0)</span>
             </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center p-3 rounded-3 mb-4">
            <i class="bi bi-exclamation-octagon-fill fs-4 me-3 text-danger"></i>
            <div>@Model.ErrorMessage</div>
        </div>
    }
    else if (Model.Reservations == null || !Model.Reservations.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body py-5">
                <div class="bg-light d-inline-block rounded-circle p-4 mb-4">
                    <i class="bi bi-car-front text-muted display-4"></i>
                </div>
                <h3 class="fw-bold text-dark">Brak historii rezerwacji</h3>
                <p class="text-muted col-md-6 mx-auto mb-4">Wygląda na to, że nie korzystałeś jeszcze z naszych usług. Wybierz samochód z oferty i ruszaj w drogę.</p>
                <a href="/" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">Zobacz ofertę</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0 w-100 custom-table">
                    <thead class="bg-white border-bottom">
                        <tr>
                            <th class="ps-5 py-4 text-secondary text-uppercase fw-bold fs-7 ls-1 border-0">Pojazd</th>
                            <th class="px-4 py-4 text-secondary text-uppercase fw-bold fs-7 ls-1 border-0">Termin</th>
                            <th class="px-4 py-4 text-secondary text-uppercase fw-bold fs-7 ls-1 border-0 text-end">Stawka</th>
                            <th class="px-4 py-4 text-secondary text-uppercase fw-bold fs-7 ls-1 border-0 text-center">Okres</th>
                            <th class="px-4 py-4 text-secondary text-uppercase fw-bold fs-7 ls-1 border-0 text-end">Suma</th>
                            <th class="pe-5 py-4 text-secondary text-uppercase fw-bold fs-7 ls-1 border-0 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        @foreach (var r in Model.Reservations)
                        {
                            // --- LOGIKA ---
                            var s = r.Status.ToString();
                            var sLower = s.ToLower();

                            string badgeClass = "bg-secondary bg-opacity-10 text-secondary";
                            string dotClass = "bg-secondary"; // Kropka statusu

                            if (sLower.Contains("aktywna") || sLower.Contains("active"))
                            {
                                badgeClass = "bg-success bg-opacity-10 text-success";
                                dotClass = "bg-success";
                            }
                            else if (sLower.Contains("anul") || sLower.Contains("cancel"))
                            {
                                badgeClass = "bg-danger bg-opacity-10 text-danger";
                                dotClass = "bg-danger";
                            }
                            // --------------

                            <tr class="hover-effect border-bottom border-light">
                                <td class="ps-5 py-4">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box bg-light rounded-3 d-flex align-items-center justify-content-center me-3 text-primary">
                                            <i class="bi bi-car-front-fill fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark fs-6 mb-1">@r.CarDisplay</div>
                                            <div class="text-muted small font-monospace">ID: @r.GetHashCode().ToString("X").Substring(0, 4)</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-4 py-4">
                                    <div class="d-flex align-items-center gap-4">
                                        <div class="text-end">
                                            <div class="fw-semibold text-dark fs-6">@r.DateFrom.ToString("dd MMM")</div>
                                            <div class="text-muted small">@r.DateFrom.ToString("yyyy")</div>
                                        </div>
                                        <div class="text-muted opacity-50"><i class="bi bi-arrow-right fs-5"></i></div>
                                        <div>
                                            <div class="fw-semibold text-dark fs-6">@r.DateTo.ToString("dd MMM")</div>
                                            <div class="text-muted small">@r.DateTo.ToString("yyyy")</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-4 py-4 text-end">
                                    <span class="text-muted">@r.DailyPrice.ToString("0.00")</span> <small class="text-muted">pln</small>
                                </td>

                                <td class="px-4 py-4 text-center">
                                    <span class="badge bg-light text-dark border fw-normal px-3 py-2 rounded-pill">@r.Days dni</span>
                                </td>

                                <td class="px-4 py-4 text-end">
                                    <span class="fw-bold text-dark fs-6">@r.TotalCost.ToString("0.00")</span> <small class="text-muted">pln</small>
                                </td>

                                <td class="pe-5 py-4 text-center">
                                    <div class="d-inline-flex align-items-center px-3 py-2 rounded-pill @badgeClass">
                                        <span class="status-dot rounded-circle me-2 @dotClass"></span>
                                        <span class="fw-semibold small text-uppercase" style="letter-spacing: 0.5px;">@s</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="text-center mt-5 text-muted small">
            <p>System Rezerwacji Pojazdów &copy; 2026. Potrzebujesz faktury? <a href="#" class="text-decoration-none fw-bold">Pobierz dokumenty</a></p>
        </div>
    }
</div>

<style>
    /* CUSTOM CSS DLA WERSJI PRO */
    
    body {
        background-color: #f8f9fa; 
    }

    .fs-7 {
        font-size: 0.75rem;
    }
    .ls-1 {
        letter-spacing: 1px;
    }
    
    .icon-box {
        width: 48px;
        height: 48px;
        transition: all 0.3s ease;
    }

    .hover-effect {
        transition: background-color 0.2s ease, transform 0.2s ease;
    }
    .hover-effect:hover {
        background-color: #fafafa;
    }
    .hover-effect:hover .icon-box {
        background-color: #e9ecef !important;
        transform: scale(1.1);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        display: inline-block;
    }
    
    .custom-table {
        min-width: 1100px; /* Zwiększyłem minimalną szerokość tabeli, żeby wszystko się mieściło */
    }
</style>