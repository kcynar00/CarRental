@page
@model CarRental.Pages.Reservations.CreateModel
@{
    ViewData["Title"] = "Rezerwacja";
    var reservedUrl = Url.Page("/Reservations/Create", null, new { handler = "ReservedRanges" });
}

<h1>Rezerwacja samochodu</h1>

<form method="post" class="mt-3">
    <div class="mb-3">
        <label class="form-label">Samochód</label>
        <select id="carSelect" class="form-select" asp-for="Input.CarId" asp-items="Model.CarOptions">
            <option value="">-- wybierz samochód --</option>
        </select>
        <span class="text-danger" asp-validation-for="Input.CarId"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Data od</label>
        <input id="dateFrom" class="form-control" asp-for="Input.DateFrom" />
        <span class="text-danger" asp-validation-for="Input.DateFrom"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Data do</label>
        <input id="dateTo" class="form-control" asp-for="Input.DateTo" />
        <span class="text-danger" asp-validation-for="Input.DateTo"></span>
    </div>

    <button type="submit" class="btn btn-primary">Zarezerwuj</button>
    <a class="btn btn-secondary" asp-page="/Cars">Powrót</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- flatpickr (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        const reservedUrl = '@reservedUrl';

        // [{from:"2026-02-01", to:"2026-02-05"}, ...]
        let reservedRanges = [];

        function toDateOnly(d) {
            return new Date(d.getFullYear(), d.getMonth(), d.getDate());
        }

        function parseYmd(ymd) {
            const [y, m, d] = ymd.split("-").map(x => parseInt(x, 10));
            return new Date(y, m - 1, d);
        }

        function isReserved(date) {
            const day = toDateOnly(date).getTime();
            for (const r of reservedRanges) {
                const from = parseYmd(r.from).getTime();
                const to = parseYmd(r.to).getTime();
                if (day >= from && day <= to) return true; // inclusive
            }
            return false;
        }

        function nextReservationStart(afterDate) {
            const day = toDateOnly(afterDate).getTime();
            let best = null;
            for (const r of reservedRanges) {
                const start = parseYmd(r.from).getTime();
                if (start > day && (best === null || start < best)) best = start;
            }
            return best; // timestamp or null
        }

        async function loadReserved(carId) {
            if (!carId) {
                reservedRanges = [];
                return;
            }
            const resp = await fetch(`${reservedUrl}&carId=${carId}`);
            reservedRanges = await resp.json();
        }

        // init pickers
        const fromPicker = flatpickr("#dateFrom", {
            dateFormat: "Y-m-d",
            minDate: "today",
            disable: [(date) => isReserved(date)],
            onChange: function (selectedDates) {
                if (!selectedDates.length) return;
                const from = selectedDates[0];

                // Data "do" nie może być przed "od"
                toPicker.set("minDate", from);

                // Nie pozwól wybrać "do" po rozpoczęciu najbliższej rezerwacji
                const nextStart = nextReservationStart(from);
                if (nextStart !== null) {
                    const maxTo = new Date(nextStart);
                    maxTo.setDate(maxTo.getDate() - 1); // dzień przed startem kolejnej rezerwacji
                    toPicker.set("maxDate", maxTo);
                } else {
                    toPicker.set("maxDate", null);
                }

                // jeśli aktualne "do" wypadło poza limitem / w rezerwacji → wyczyść
                if (toPicker.selectedDates.length) {
                    const currentTo = toPicker.selectedDates[0];
                    const maxDate = toPicker.config.maxDate;
                    if (isReserved(currentTo) || (maxDate && currentTo > maxDate)) {
                        toPicker.clear();
                    }
                }
            }
        });

        const toPicker = flatpickr("#dateTo", {
            dateFormat: "Y-m-d",
            minDate: "today",
            disable: [(date) => isReserved(date)]
        });

        async function refreshForSelectedCar() {
            const carId = document.getElementById("carSelect").value;
            await loadReserved(carId);

            fromPicker.set("disable", [(date) => isReserved(date)]);
            toPicker.set("disable", [(date) => isReserved(date)]);

            // jeśli zaznaczone daty teraz są niedozwolone → czyścimy
            if (fromPicker.selectedDates.length && isReserved(fromPicker.selectedDates[0])) fromPicker.clear();
            if (toPicker.selectedDates.length && isReserved(toPicker.selectedDates[0])) toPicker.clear();

            // reset maxDate dopóki nie wybierzesz "od"
            toPicker.set("maxDate", null);
        }

        document.getElementById("carSelect").addEventListener("change", refreshForSelectedCar);

        // on load: jeśli przyszliśmy z ?carId=... dropdown jest ustawiony → od razu dociągnij rezerwacje
        refreshForSelectedCar();
    </script>
}
